DATABASE_URL=postgresql://knowledge_app:LOCAL_PASSWORD@127.0.0.1:5432/embodied_knowledge
STORAGE_ROOT=storage

# Optional LLM access. Backend only; never use VITE_ variables for secrets.
# The base URL must support POST <base>/chat/completions.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Set the exact model ID available in your provider account.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
# Some compatible providers require max_tokens instead.
LLM_TOKEN_PARAMETER=max_completion_tokens

# Optional MCP import provider (Streamable HTTP). Leave blank to hide it.
MCP_IMPORT_SERVER_URL=
MCP_IMPORT_TOOL=import_source
MCP_IMPORT_ARGUMENT=source

# Optional: raises the unauthenticated GitHub API rate limit.
GITHUB_TOKEN=

